DATABASE_URL=postgresql+psycopg://leave_app:local-password@localhost:5432/leave_portal
JWT_SECRET=replace-with-a-long-random-local-secret
ACCESS_TOKEN_MINUTES=720
DEMO_PASSWORD=choose-a-local-demo-password
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: enable OpenTelemetry tracing by pointing at an OTLP collector
# (the docker compose stack sets this to http://jaeger:4317 automatically)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317