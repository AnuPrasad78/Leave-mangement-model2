VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Service-role key. NEVER prefix with VITE_ — a VITE_-prefixed value is inlined
# into the client bundle at build time. Used only by scripts/seed-users.mjs and
# optional e2e cleanup.
SUPABASE_SERVICE_ROLE_KEY=

# Password used by scripts/seed-users.mjs (default: Portal@2026)
SEED_PASSWORD=
