    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "pixelmatch": "^5.3.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "storybook": "^8.6.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^2.1.9"
